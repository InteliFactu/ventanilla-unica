{
  "name": "ventanilla-unica",
  "version": "0.3.0",
  "description": "Command-line client for the Spanish public administration portals (AEAT, TGSS, SEPE, DEHU, OARGT, CIRBE) with the holder's own certificate: reads by default, local PAdES and XAdES signing, confirmed writes.",
  "license": "MIT",
  "private": false,
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "bin": {
    "ventanilla-unica": "dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InteliFactu/ventanilla-unica.git"
  },
  "homepage": "https://github.com/InteliFactu/ventanilla-unica#readme",
  "bugs": {
    "url": "https://github.com/InteliFactu/ventanilla-unica/issues"
  },
  "keywords": [
    "aeat",
    "tgss",
    "dehu",
    "clave",
    "certificado-digital",
    "sede-electronica",
    "spain",
    "hacienda",
    "seguridad-social"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "lint:suppress": "eslint src --suppress-all",
    "lint:prune": "eslint src --prune-suppressions",
    "fix": "pnpm lint:fix && pnpm format",
    "format": "prettier --write . --list-different",
    "format:check": "prettier --check .",
    "type-check": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "dupes": "baseline-dupes .",
    "knip": "knip",
    "check:all": "pnpm type-check && pnpm lint && pnpm format:check && pnpm dupes",
    "check:ci": "pnpm lint:fast && pnpm type-check && pnpm lint && pnpm format:check && pnpm test && pnpm dupes && pnpm knip",
    "deps:graph": "depcruise src",
    "type-coverage": "baseline-type-coverage",
    "secrets:check": "gitleaks detect --no-banner --redact",
    "audit:check": "baseline-audit --level moderate",
    "check:quality": "pnpm deps:graph && pnpm type-coverage",
    "check:security": "pnpm secrets:check && pnpm audit:check",
    "lint:fast": "oxlint --deny-warnings .",
    "build": "tsup",
    "prepack": "pnpm build && pnpm publish:check",
    "publish:check": "publint --strict"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@syntopica/eslint-config": "^0.9.0",
    "@syntopica/prettier-config": "^0.2.0",
    "@syntopica/quality-config": "^0.11.1",
    "@syntopica/tsconfig": "^0.3.0",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-code-policy": "^0.8.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^76.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jscpd": "^5.3.0",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "type-coverage": "^2.30.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
